# ---- Ollama (local LLM runtime) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Context window for the chat model. The default (4096) is too small for the
# system prompt + several tool results, so we raise it. Costs RAM, not accuracy.
OLLAMA_NUM_CTX=8192

# Pre-fetch price + filings + RAG context for symbols mentioned in a question.
# Keeps answers grounded even when a small model under-plans its tool calls.
AGENT_AUTO_CONTEXT=true

# ---- Vector store ----
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=nse_documents

# ---- Ingestion / scheduling ----
RAG_REFRESH_INTERVAL_MINUTES=5
NSE_SESSION_REFRESH_MINUTES=15
# How many RSS items per feed to ingest on each refresh (feeds can hold 1000+).
MAX_ITEMS_PER_FEED=1500

# ---- Logging ----
LOG_DIR=./logs
LOG_LEVEL=INFO
